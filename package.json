{
  "name": "p2pexp",
  "productName": "p2pexp",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "upgrade": "pear://zd67x8kjx9wz4od341dmek3gu4se1hd3bqbmyehkbf5shng66smo",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env PEAR_DEV_SERVER_URL=http://127.0.0.1:5173 electron . --no-updates\"",
    "start": "npm run build && electron . --no-updates",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test && npm run build && node tests/e2e.js",
    "format": "prettier --write frontend/src workers",
    "package": "npm run build && electron-forge package"
  },
  "dependencies": {
    "autopass": "3.4.1",
    "bare-path": "3.1.2",
    "bare-storage": "1.1.0",
    "corestore": "7.13.0",
    "framed-stream": "1.0.1",
    "graceful-goodbye": "1.3.3",
    "hyperswarm": "4.17.2",
    "paparam": "1.13.0",
    "pear-runtime": "1.3.1",
    "which-runtime": "1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/core": "^8.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
